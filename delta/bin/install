#!/bin/sh
# delta install - make the five delta commands available on this machine, in
# every repository, with no per-repo setup.
#
# Usage:  delta/bin/install
#
# What it does, and nothing else: writes the five command files into every
# adapter's user_dir (from delta/adapters.yaml), e.g. ~/.claude/commands/,
# ~/.gemini/commands/. Nothing else is installed, and nothing is written
# anywhere else - there is no global copy of the runner. delta/bin/verify is
# committed in each repository; that is the only copy, always. A repo that
# wants delta gets delta/bin/verify by copying it in from another repo that
# already has it - one file, one command, no install step for it at all.
#
# It copies files that already exist in this checkout. No network fetch, no
# package manager, nothing installed beyond those copies.
#
# Safe to re-run: it always overwrites with the current canonical source, and
# a project's own committed command files still win over these (that
# precedence is the CLIs' own behaviour, not something this script controls).
#
# To uninstall: rm -rf the user_dir paths this script printed below. No
# repository is touched by either installing or uninstalling.

set -u

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
DELTA_DIR=$(dirname -- "$script_dir")
ROOT=$(dirname -- "$DELTA_DIR")

die() { printf 'install: %s\n' "$1" >&2; exit 1; }

[ -n "${HOME-}" ] || die "\$HOME is not set"
[ -x "$DELTA_DIR/bin/generate-commands" ] || die "no generate-commands at $DELTA_DIR/bin/generate-commands"

printf '\n  installing delta commands\n\n'

"$DELTA_DIR/bin/generate-commands" --target user || die "generate-commands --target user failed"

printf '\n  every repo on this machine now has /delta-explore and friends.\n'
printf '  the first delta/propose in a repo creates that repo'"'"'s own delta/ -\n'
printf '  nothing else to run, except delta/bin/verify itself: copy that one\n'
printf '  file in from a repo that already has it, and commit it. it is the\n'
printf '  only copy, ever - nothing here tracks a version of it.\n\n'
printf '  to uninstall: rm -rf the user-level command directories listed\n'
printf '  above. no repository is touched.\n\n'

#!/bin/sh
# delta verify - run the checks bound to a change's acceptance criteria.
#
# Usage:  delta/bin/verify [--archive-gate] [change-id]
#         delta/bin/verify --all
#         DELTA_CHANGE=<id> delta/bin/verify
#         DELTA_ROOT=<path> delta/bin/verify
#
# With no argument the most recently modified directory under delta/changes/
# is used.
#
# --all (CR-006) is a read-only dashboard across every change: it never
# executes a check, only reads what past runs already wrote to
# run/*/results.tsv, and shows each criterion's last eight runs as a
# duration/pass-fail sparkline. Exits 0 unless the repository itself could
# not be resolved - it is a report, not a verdict, so it has no other exit
# code to give.
#
# Root: by default this script resolves the repository root from its own
# location (it lives at <root>/delta/bin/verify, wherever that is), which
# already works correctly from any cwd. Set DELTA_ROOT to override that and
# point at a different repository's delta/ explicitly. When the resolved
# root is not the current directory, the run announces it.
#
# This script is committed in the repository. That is the only copy, ever.
# The checks and the runner that executes them travel together in the same
# commit and cannot disagree.
#
# Exit codes:
#   0  every criterion has a check, every check passed, every MANUAL signed off
#   1  at least one check failed
#   2  at least one criterion has no corresponding check
#   3  at least one MANUAL criterion has no recorded sign-off
#   4  cannot run at all (no such change, no spec, no criteria)
#   5  --archive-gate only: a reproduction is still outstanding
#   6  a reproduction did not reproduce (see EXPECT below)
#   7  at least one check could not run at all (see Errors vs failures below)
#
# When several apply the precedence is 7 > 1 > 6 > 2 > 3 > 5. A criterion is
# never counted as passing because nothing ran for it; that is what codes 2
# and 3 exist for.
#
# Errors vs failures
#   A check that could not run at all - missing executable bit, a shebang
#   naming an interpreter that is missing or not itself executable - is an
#   *error*, exit 7, never counted as a failed criterion. The check said
#   nothing about whether the criterion holds; reporting it as a failure
#   would send someone to debug application code that is fine. This is
#   detected two ways: the executable-bit check before a check ever runs, and
#   exit codes 126 (permission denied) and 127 (command not found) after -
#   the shell's own conventional codes for "could not execute this at all".
#
# Reproduction checks
#   A check may declare an expectation in a header comment:
#
#       # EXPECT: fail-until-fixed
#
#   Default is `pass`, so a check with no EXPECT header behaves exactly as it
#   always has. A fail-until-fixed check that fails is *reproduced*, not
#   failed: the bug is confirmed and the fix is not written yet, so a run whose
#   only non-passing checks are reproductions exits 0.
#
#   When such a check passes, one of two things is true:
#     - it was reproduced on an earlier run (recorded in run/reproductions.md),
#       so the fix works. The check flips permanently to a normal check and the
#       flip is recorded with a timestamp.
#     - it was never reproduced, so the reproduction does not reproduce and the
#       criterion is wrong. That is *suspicious* and exits 6. Accepting it
#       silently would let someone "fix" a bug they never reproduced.
#
# No model is involved in this script. A check is an executable file: it exits
# 0 or it does not.
#
# Lifecycle rail and startup reveal (CR-006)
#   The opening frame is followed by delta/bin/stage-rail's two-line output -
#   see that script's own header for how each stage's state is computed.
#   The frame itself draws with a brief (roughly 200ms) left-to-right reveal
#   the first time this runs in a given terminal session (keyed by `tty`'s
#   device path), then instantly on every command after that in the same
#   session. Skipped entirely off a TTY, or if `tty`/`stty` are not usable.
#   Interruptible by any keypress, via a non-blocking read against the
#   controlling tty (`stty ... min 0 time 0` + the shell's own `read`
#   builtin - no `read -t`, a bash-ism dash does not have).

set -u

TAB=$(printf "\t")

# ---------------------------------------------------------------- locate ----

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 4

# The one file that knows what colour or glyph anything is - see its own
# header. Sourced from a fixed, known-good location (this script's own
# directory), not searched for, so a bad cwd can never silently pick up a
# different one.
. "$script_dir/palette.sh"

die() {
    printf '  delta verify: %s\n' "$1" >&2
    exit 4
}

if [ -n "${DELTA_ROOT-}" ]; then
    [ -d "$DELTA_ROOT" ] || die "DELTA_ROOT does not exist: $DELTA_ROOT"
    ROOT=$(CDPATH= cd -- "$DELTA_ROOT" && pwd) || die "cannot resolve DELTA_ROOT: $DELTA_ROOT"
    [ -d "$ROOT/delta" ] || die "DELTA_ROOT has no delta/ directory: $ROOT"
    DELTA_DIR="$ROOT/delta"
else
    DELTA_DIR=$(dirname -- "$script_dir")
    ROOT=$(dirname -- "$DELTA_DIR")
fi
CHANGES_DIR="$DELTA_DIR/changes"

cwd=$(pwd) || cwd=''
root_announced=0
announce_root_if_needed() {
    [ "$root_announced" -eq 1 ] && return 0
    root_announced=1
    [ -n "$cwd" ] && [ "$cwd" = "$ROOT" ] && return 0
    printf '  %s\n' "$(trunc "root: $ROOT" "$((cols - 2))")"
}

archive_gate=0
all_mode=0
while [ $# -gt 0 ]; do
    case "$1" in
        --archive-gate) archive_gate=1; shift ;;
        --all) all_mode=1; shift ;;
        --) shift; break ;;
        -*) die "unknown option: $1" ;;
        *) break ;;
    esac
done

if [ "$all_mode" -eq 1 ]; then
    [ -d "$CHANGES_DIR" ] || die "no delta/changes/ directory yet - run propose first"
else
    change=${1:-${DELTA_CHANGE:-}}
    if [ -z "$change" ]; then
        [ -d "$CHANGES_DIR" ] || die "no delta/changes/ directory yet - run propose first"
        change=$(ls -t "$CHANGES_DIR" 2>/dev/null | head -n 1)
        [ -n "$change" ] || die "no changes under delta/changes/ - run propose first"
    fi

    # An argument containing a slash is treated as a path to a change directory;
    # anything else is an id under delta/changes/.
    change=${change%/}
    case "$change" in
        */*) CHANGE_DIR=$change ;;
        *)   CHANGE_DIR="$CHANGES_DIR/$change" ;;
    esac
    label=${CHANGE_DIR##*/}
    SPEC="$CHANGE_DIR/spec.md"
    CHECKS_DIR="$CHANGE_DIR/checks"
    SIGNOFF="$CHANGE_DIR/run/signoff.md"

    [ -d "$CHANGE_DIR" ] || die "no such change: $change"
    [ -f "$SPEC" ]       || die "no spec.md in $CHANGE_DIR"
fi

# ---------------------------------------------------------- capabilities ----

is_tty=0
[ -t 1 ] && is_tty=1

use_color=$is_tty
[ -n "${NO_COLOR-}" ] && use_color=0

loc="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
case "$loc" in
    *UTF-8*|*utf-8*|*UTF8*|*utf8*) unicode=1 ;;
    *)                             unicode=0 ;;
esac

cols=0
case "${COLUMNS-}" in ''|*[!0-9]*) : ;; *) cols=$COLUMNS ;; esac
if [ "$cols" -eq 0 ] && command -v tput >/dev/null 2>&1; then
    # /dev/tty, not a bare `tput cols`: this value is also read again later
    # from inside a piped while-read loop, where the loop body's own stdin
    # is the pipe, not the terminal - tput queries via stdin and silently
    # falls back to a wrong default (typically 80) if it is not a tty.
    # Querying /dev/tty directly works from both contexts identically.
    cols=$(tput cols 2>/dev/null </dev/tty) || cols=0
fi
case "$cols" in ''|*[!0-9]*) cols=0 ;; esac
[ "$cols" -lt 40 ] && cols=80
[ "$cols" -gt 100 ] && cols=100

spinner_ok=0
if [ "$is_tty" -eq 1 ] && sleep 0.1 2>/dev/null; then
    spinner_ok=1
fi

if [ "$unicode" -eq 1 ]; then
    G_PASS=$PALETTE_GLYPH_PASS_UTF8;   G_FAIL=$PALETTE_GLYPH_FAIL_UTF8
    G_MAN=$PALETTE_GLYPH_MANUAL_UTF8;  G_PEND=$PALETTE_GLYPH_PENDING_UTF8
    G_REPRO=$PALETTE_GLYPH_REPRO_UTF8; G_SUSP=$PALETTE_GLYPH_SUSPICIOUS_UTF8
    G_ERR=$PALETTE_GLYPH_ERROR_UTF8
    SIG=$PALETTE_SIGIL_UTF8; RULE=$PALETTE_RULE_UTF8
    SEP=$PALETTE_SEP_UTF8;   ELL=$PALETTE_ELLIPSIS_UTF8
    SPIN=$PALETTE_SPIN_UTF8
    GLYPH_W=1
else
    G_PASS=$PALETTE_GLYPH_PASS_ASCII;   G_FAIL=$PALETTE_GLYPH_FAIL_ASCII
    G_MAN=$PALETTE_GLYPH_MANUAL_ASCII;  G_PEND=$PALETTE_GLYPH_PENDING_ASCII
    G_REPRO=$PALETTE_GLYPH_REPRO_ASCII; G_SUSP=$PALETTE_GLYPH_SUSPICIOUS_ASCII
    G_ERR=$PALETTE_GLYPH_ERROR_ASCII
    SIG=$PALETTE_SIGIL_ASCII; RULE=$PALETTE_RULE_ASCII
    SEP=$PALETTE_SEP_ASCII;   ELL=$PALETTE_ELLIPSIS_ASCII
    SPIN=$PALETTE_SPIN_ASCII
    GLYPH_W=6
fi

SPIN_N=0
for _f in $SPIN; do SPIN_N=$((SPIN_N + 1)); done

# Truecolor: only used for the gradient rule, and only when colour is on at
# all (so NO_COLOR and non-TTY both disable it along with everything else).
# COLORTERM is the one portable signal for 24-bit support - there is no
# universal `tput` query for it.
use_truecolor=0
if [ "$use_color" -eq 1 ]; then
    case "${COLORTERM-}" in truecolor|24bit) use_truecolor=1 ;; esac
fi

if [ "$use_color" -eq 1 ]; then
    C_PASS=$(printf '\033[%sm' "$PALETTE_ANSI_PASS")
    C_FAIL=$(printf '\033[%sm' "$PALETTE_ANSI_FAIL")
    C_DIM=$(printf '\033[%sm' "$PALETTE_ANSI_DIM")
    if [ "$use_truecolor" -eq 1 ]; then
        C_ACCENT=$(printf '\033[%sm' "$(palette_ansi_truecolor "$PALETTE_RGB_ACCENT")")
    else
        C_ACCENT=$(printf '\033[%sm' "$PALETTE_ANSI_ACCENT")
    fi
    C_OFF=$(printf '\033[0m')
    CLEAR=$(printf '\r\033[2K')
    CURSOR_HIDE=$(printf '\033[?25l')
    CURSOR_SHOW=$(printf '\033[?25h')
else
    C_PASS=''; C_FAIL=''; C_DIM=''; C_ACCENT=''; C_OFF=''; CLEAR=''
    CURSOR_HIDE=''; CURSOR_SHOW=''
fi

# Restore the terminal on every exit path - the single most likely bug in
# terminal code is a cursor left invisible after Ctrl-C. This has to be set
# up before anything ever hides the cursor, and it must be unconditional:
# even a no-colour run prints CURSOR_SHOW (which is empty in that case, so
# the trap is always safe to fire).
reveal_stty_saved=''
reveal_tty_dev=''
restore_terminal() {
    [ -n "$reveal_stty_saved" ] && stty "$reveal_stty_saved" < "$reveal_tty_dev" 2>/dev/null
    reveal_stty_saved=''
    printf '%s%s' "$CURSOR_SHOW" "$C_OFF"
}

# A signal delivered to this shell does not automatically reach a
# backgrounded check subprocess - `cpid` (set right before each check is
# started, cleared right after) has to be killed explicitly, or Ctrl-C
# leaves the check running to completion in the background while the parent
# exits, which is worse than doing nothing: the terminal looks free but a
# check is still writing to the log underneath it.
cpid=''
on_signal() {
    [ -n "$cpid" ] && kill "$cpid" 2>/dev/null
    restore_terminal
}
trap restore_terminal EXIT
trap 'on_signal; trap - INT; kill -INT $$' INT
trap 'on_signal; trap - TERM; kill -TERM $$' TERM

# ------------------------------------------------------------- utilities ----

pad() {  # pad $1 with spaces to width $2
    _s=$1; _w=$2
    while [ ${#_s} -lt "$_w" ]; do _s="$_s "; done
    printf '%s' "$_s"
}

pad_left() {  # right-align $1 in width $2, truncating if it will not fit
    _s=$1; _w=$2
    [ ${#_s} -gt "$_w" ] && _s=$(printf '%s' "$_s" | cut -c "1-$_w")
    while [ ${#_s} -lt "$_w" ]; do _s=" $_s"; done
    printf '%s' "$_s"
}

trunc() {  # truncate $1 to width $2, never wrap
    _s=$1; _w=$2
    [ "$_w" -lt 4 ] && _w=4
    if [ ${#_s} -gt "$_w" ]; then
        _s=$(printf '%s' "$_s" | cut -c "1-$((_w - 1))")
        _s="$_s$ELL"
    fi
    printf '%s' "$_s"
}

# gradient_rule <n> - the rule character n times, faded left to right from
# the accent colour to the dim foreground. Truecolor only (see use_truecolor
# above); everything else gets the plain flat dim rule in rule_line below.
# Integer RGB interpolation - no floating point in POSIX arithmetic, and at
# rule-line lengths (tens of characters) the rounding is invisible.
gradient_rule() {
    _n=$1
    [ "$_n" -le 0 ] && return 0
    set -- $PALETTE_RGB_ACCENT;  _ar=$1; _ag=$2; _ab=$3
    set -- $PALETTE_RGB_FG_DIM;  _dr=$1; _dg=$2; _db=$3
    _i=0
    while [ "$_i" -lt "$_n" ]; do
        if [ "$_n" -gt 1 ]; then
            _gr=$(( _ar + (_dr - _ar) * _i / (_n - 1) ))
            _gg=$(( _ag + (_dg - _ag) * _i / (_n - 1) ))
            _gb=$(( _ab + (_db - _ab) * _i / (_n - 1) ))
        else
            _gr=$_ar; _gg=$_ag; _gb=$_ab
        fi
        printf '\033[38;2;%s;%s;%sm%s' "$_gr" "$_gg" "$_gb" "$RULE"
        _i=$((_i + 1))
    done
    printf '%s' "$C_OFF"
}

rule_line() {  # signature frame: two spaces, sigil, rule, right-hand label
    # $2, if passed, is a colour to wrap the whole line in (the completion
    # moment - accent on a clean run) instead of the default dim/plain rule.
    # $3, if the label ($1) contains embedded colour codes, is the plain
    # (uncoloured) equivalent to measure and truncate against - escape
    # sequences are zero-width on screen but count as characters in ${#_s},
    # so width math has to use the plain text even when display uses $1.
    _label=$1; _linecolor=${2:-}; _plain=${3:-$1}
    _maxlabel=$((cols - 4 - 2 - 3))
    [ "$_maxlabel" -lt 8 ] && _maxlabel=8
    if [ ${#_plain} -gt "$_maxlabel" ]; then
        _plain=$(trunc "$_plain" "$_maxlabel")
        _label=$_plain
    fi
    _avail=$((cols - 4 - ${#_plain} - 2))
    [ "$_avail" -lt 3 ] && _avail=3
    if [ "$use_truecolor" -eq 1 ] && [ -z "$_linecolor" ]; then
        _r=$(gradient_rule "$_avail")
    else
        _r=''; _i=0
        while [ "$_i" -lt "$_avail" ]; do _r="$_r$RULE"; _i=$((_i + 1)); done
        [ -n "$_linecolor" ] && _r="$_linecolor$_r$C_OFF"
    fi
    # _linecolor wraps only the sigil and rule dashes, never the label: the
    # label may already carry its own embedded colour spans (the summary's
    # per-count green/red), and nesting a wrapper around those would have
    # the label's own trailing reset cancel the wrapper's colour partway
    # through instead of restoring it - ANSI resets go to terminal default,
    # never back to "whatever was active before".
    printf '  %s %s  %s\n' "${_linecolor}${SIG}${_linecolor:+$C_OFF}" "$_r" "$_label"
}

# reveal_opening_frame <label> - CR-006's startup moment: the first delta
# command in a terminal session draws the opening frame with a brief
# left-to-right reveal (roughly 200ms), instead of appearing all at once.
# Once per terminal session (keyed by `tty`'s device path, so a second pane
# gets its own reveal), skipped off a TTY or when `sleep`/`tty`/`stty`/`dd`
# are not usable, and interruptible by any keypress - reads non-blocking
# from the controlling tty via `stty ... min 0 time 0` + `dd bs=1 count=1`,
# a POSIX-portable way to poll for input with no `read -t` (a bash-ism dash
# does not have). Every other command after the first in the same session
# prints the frame instantly, same as rule_line always has.
reveal_opening_frame() {
    _label=$1
    _plain=$_label
    _maxlabel=$((cols - 4 - 2 - 3))
    [ "$_maxlabel" -lt 8 ] && _maxlabel=8
    if [ ${#_plain} -gt "$_maxlabel" ]; then
        _plain=$(trunc "$_plain" "$_maxlabel")
        _label=$_plain
    fi
    _avail=$((cols - 4 - ${#_plain} - 2))
    [ "$_avail" -lt 3 ] && _avail=3

    _do_reveal=0
    if [ "$is_tty" -eq 1 ] && [ "$spinner_ok" -eq 1 ] \
        && command -v tty >/dev/null 2>&1 && command -v stty >/dev/null 2>&1 \
        && command -v dd >/dev/null 2>&1; then
        _ttypath=$(tty 2>/dev/null) || _ttypath=''
        case "$_ttypath" in
            /*)
                _markerdir="${TMPDIR:-/tmp}/.delta-reveal-seen"
                mkdir -p "$_markerdir" 2>/dev/null
                _markerkey=$(printf '%s' "$_ttypath" | tr '/' '_')
                _marker="$_markerdir/$_markerkey"
                if [ ! -f "$_marker" ] && [ -w "$_markerdir" ]; then
                    _do_reveal=1
                    reveal_tty_dev=$_ttypath
                fi
                ;;
        esac
    fi

    if [ "$_do_reveal" -eq 0 ]; then
        rule_line "$_label" '' "$_plain"
        return 0
    fi

    printf '%s' "$CURSOR_HIDE"
    reveal_stty_saved=$(stty -g < "$reveal_tty_dev" 2>/dev/null) || reveal_stty_saved=''
    if [ -n "$reveal_stty_saved" ]; then
        stty -icanon -echo min 0 time 0 < "$reveal_tty_dev" 2>/dev/null
        # Open once, poll many times from the same fd: reopening the device
        # path fresh on every poll (or shelling out to `dd`/anything external)
        # costs a fork+exec per poll, which on a loaded machine can outrun the
        # whole reveal's own 200ms budget. The shell's own `read` builtin
        # against an already-non-canonical fd needs neither.
        exec 3< "$reveal_tty_dev" 2>/dev/null || reveal_stty_saved=''
    fi

    if [ "$use_truecolor" -eq 1 ]; then
        set -- $PALETTE_RGB_ACCENT;  _ar=$1; _ag=$2; _ab=$3
        set -- $PALETTE_RGB_FG_DIM;  _dr=$1; _dg=$2; _db=$3
    fi

    _steps=8
    _interrupted=0
    _s=1
    while [ "$_s" -le "$_steps" ]; do
        if [ -n "$reveal_stty_saved" ] && IFS= read -r _key <&3; then
            _interrupted=1
        fi
        [ "$_interrupted" -eq 1 ] && _s=$_steps

        _shown=$(( _avail * _s / _steps ))
        [ "$_shown" -gt "$_avail" ] && _shown=$_avail
        _r=''; _i=0
        while [ "$_i" -lt "$_shown" ]; do
            if [ "$use_truecolor" -eq 1 ]; then
                if [ "$_avail" -gt 1 ]; then
                    _gr=$(( _ar + (_dr - _ar) * _i / (_avail - 1) ))
                    _gg=$(( _ag + (_dg - _ag) * _i / (_avail - 1) ))
                    _gb=$(( _ab + (_db - _ab) * _i / (_avail - 1) ))
                else
                    _gr=$_ar; _gg=$_ag; _gb=$_ab
                fi
                _r="$_r$(printf '\033[38;2;%s;%s;%sm%s' "$_gr" "$_gg" "$_gb" "$RULE")"
            else
                _r="$_r$RULE"
            fi
            _i=$((_i + 1))
        done
        [ "$use_truecolor" -eq 1 ] && _r="$_r$C_OFF"
        if [ "$_shown" -eq "$_avail" ]; then
            printf '\r  %s %s  %s' "$SIG" "$_r" "$_label"
        else
            printf '\r  %s %s' "$SIG" "$_r"
        fi
        [ "$_s" -lt "$_steps" ] && sleep 0.02
        _s=$((_s + 1))
    done
    printf '\n'

    if [ -n "$reveal_stty_saved" ]; then
        stty "$reveal_stty_saved" < "$reveal_tty_dev" 2>/dev/null
        reveal_stty_saved=''
        exec 3<&- 2>/dev/null
    fi
    mkdir -p "$_markerdir" 2>/dev/null && : > "$_marker" 2>/dev/null
}

now_ms() {
    _n=$(date +%s%N 2>/dev/null)
    case "$_n" in
        ''|*[!0-9]*) date +%s 2>/dev/null | awk '{printf "%d", $1 * 1000}' ;;
        *)           printf '%d' $((_n / 1000000)) ;;
    esac
}

fmt_dur() {  # milliseconds -> 0.4s
    _ms=$1
    printf '%d.%ds' $((_ms / 1000)) $(((_ms % 1000) / 100))
}

spin_frame() {
    _n=$(($1 % SPIN_N)); _i=0
    for _f in $SPIN; do
        [ "$_i" -eq "$_n" ] && { printf '%s' "$_f"; return; }
        _i=$((_i + 1))
    done
}

# -------------------------------------------------------------- all mode ----
# CR-006: verify --all is a read-only dashboard across every change under
# delta/changes/ - it never executes a check, it only reads what past runs
# already wrote to run/*/results.tsv. Each criterion with check-execution
# history gets an eight-slot sparkline: bar height is that criterion's own
# relative duration across the shown history, colour is pass/fail per the
# shared palette - "went from failing to passing" is a colour change,
# "started getting slower" is the bars climbing. A criterion never run yet
# gets no sparkline; there is nothing to chart.

if [ "$all_mode" -eq 1 ]; then
    if [ "$unicode" -eq 1 ]; then
        SPARK_LEVELS=$PALETTE_SPARK_UTF8
    else
        SPARK_LEVELS=$PALETTE_SPARK_ASCII
    fi
    SPARK_N=0
    for _sl in $SPARK_LEVELS; do SPARK_N=$((SPARK_N + 1)); done

    spark_char() {  # $1 level 0..SPARK_N-1
        _n=$1; _i=0
        for _sl in $SPARK_LEVELS; do
            [ "$_i" -eq "$_n" ] && { printf '%s' "$_sl"; return; }
            _i=$((_i + 1))
        done
    }

    # parse_criteria_of <spec-file> - same grammar delta/bin/verify's own
    # single-change mode parses, factored out so both paths can never disagree.
    parse_criteria_of() {
        awk '
            /^##+[ \t]*[Aa]cceptance [Cc]riteria/ { inblock = 1; next }
            /^##/                                 { inblock = 0 }
            inblock && /^[ \t]*-[ \t]+[A-Z]+[0-9]+[ \t]/ {
                sub(/^[ \t]*-[ \t]+/, "")
                id = $1
                sub(/^[A-Z]+[0-9]+[ \t]+/, "")
                kind = "AUTO"
                if ($0 ~ /^MANUAL([ \t]|$)/) { kind = "MANUAL"; sub(/^MANUAL[ \t]*/, "") }
                gsub(/[ \t]+$/, "")
                printf "%s\t%s\t%s\n", id, kind, $0
            }
        ' "$1"
    }

    # Column geometry, independent of single-change mode's - --all spans
    # many changes, so it uses its own fixed, generous id width.
    dash_idw=3
    dash_descw=$((cols - 2 - GLYPH_W - 1 - dash_idw - 2 - 12))
    [ "$dash_descw" -lt 12 ] && dash_descw=12

    dash_emit() {  # $1 glyph, $2 colour, $3 id, $4 desc, $5 right-hand text
        printf '  %s %s %s %s\n' \
            "$2$(pad "$1" "$GLYPH_W")$C_OFF" \
            "$(pad "$3" "$dash_idw")" \
            "$(pad "$(trunc "$4" "$dash_descw")" "$dash_descw")" \
            "$5"
    }

    any_change=0
    for cdir in "$CHANGES_DIR"/*/; do
        [ -d "$cdir" ] || continue
        cspec="${cdir}spec.md"
        [ -f "$cspec" ] || continue
        crit=$(parse_criteria_of "$cspec")
        [ -n "$crit" ] || continue
        any_change=1
        clabel=${cdir%/}; clabel=${clabel##*/}

        printf '\n  %s%s%s\n' "$C_DIM" "$clabel" "$C_OFF"

        crit_tmp=$(mktemp)
        printf '%s\n' "$crit" > "$crit_tmp"
        while IFS="$TAB" read -r cid ckind cdesc; do
            [ -n "$cid" ] || continue
            if [ "$ckind" = MANUAL ]; then
                dash_emit "$G_MAN" "$C_DIM" "$cid" "$cdesc" "manual"
                continue
            fi

            # Newest-8 history for this criterion, oldest of the eight first -
            # run directory names are UTC timestamps, so a plain sort is
            # chronological.
            hist_tmp=$(mktemp)
            for rdir in "$cdir"run/*/; do
                [ -f "${rdir}results.tsv" ] || continue
                awk -F"$TAB" -v id="$cid" 'NR>1 && $1==id {print $2 "\t" $5}' "${rdir}results.tsv"
            done | sort | tail -n 8 > "$hist_tmp"

            if [ ! -s "$hist_tmp" ]; then
                dash_emit "$G_PEND" "$C_DIM" "$cid" "$cdesc" "no runs yet"
                rm -f "$hist_tmp"
                continue
            fi

            dmin=''; dmax=''
            while IFS="$TAB" read -r _hs hd; do
                case "$hd" in ''|*[!0-9]*) continue ;; esac
                [ -z "$dmin" ] && dmin=$hd && dmax=$hd
                [ "$hd" -lt "$dmin" ] && dmin=$hd
                [ "$hd" -gt "$dmax" ] && dmax=$hd
            done < "$hist_tmp"
            [ -z "$dmin" ] && dmin=0
            [ -z "$dmax" ] && dmax=0

            if [ "$unicode" -eq 1 ]; then
                spark=''; last_dur=0
                while IFS="$TAB" read -r hstatus hdur; do
                    [ -n "$hstatus" ] || continue
                    case "$hstatus" in
                        passed|fixed) hc=$C_PASS ;;
                        reproduced)   hc='' ;;
                        *)            hc=$C_FAIL ;;
                    esac
                    case "$hdur" in ''|*[!0-9]*) hdur=0 ;; esac
                    if [ "$dmax" -gt "$dmin" ]; then
                        lvl=$(( (hdur - dmin) * (SPARK_N - 1) / (dmax - dmin) ))
                    else
                        lvl=$((SPARK_N / 2))
                    fi
                    spark="${spark}${hc}$(spark_char "$lvl")${C_OFF}"
                    last_dur=$hdur
                done < "$hist_tmp"
                dash_emit "$G_PASS" "$C_PASS" "$cid" "$cdesc" "$spark  $(fmt_dur "$last_dur")"
            else
                total=0; ok=0; sumdur=0
                while IFS="$TAB" read -r hstatus hdur; do
                    [ -n "$hstatus" ] || continue
                    total=$((total + 1))
                    case "$hstatus" in passed|fixed) ok=$((ok + 1)) ;; esac
                    case "$hdur" in ''|*[!0-9]*) hdur=0 ;; esac
                    sumdur=$((sumdur + hdur))
                done < "$hist_tmp"
                [ "$total" -gt 0 ] && avg=$((sumdur / total)) || avg=0
                dash_emit "$G_PASS" "$C_PASS" "$cid" "$cdesc" "$ok/$total $(fmt_dur "$avg") avg"
            fi
            rm -f "$hist_tmp"
        done < "$crit_tmp"
        rm -f "$crit_tmp"
    done
    [ "$any_change" -eq 1 ] || printf '\n  %sno changes with acceptance criteria yet%s\n' "$C_DIM" "$C_OFF"
    printf '\n'
    exit 0
fi

# --------------------------------------------------------------- parsing ----

# Criteria live under an "## Acceptance criteria" heading in spec.md, one per
# line:   - C1 retry returns 200
#         - C4 MANUAL errors are readable by support staff
CRITERIA=$(awk '
    /^##+[ \t]*[Aa]cceptance [Cc]riteria/ { inblock = 1; next }
    /^##/                                 { inblock = 0 }
    inblock && /^[ \t]*-[ \t]+[A-Z]+[0-9]+[ \t]/ {
        sub(/^[ \t]*-[ \t]+/, "")
        id = $1
        sub(/^[A-Z]+[0-9]+[ \t]+/, "")
        kind = "AUTO"
        if ($0 ~ /^MANUAL([ \t]|$)/) { kind = "MANUAL"; sub(/^MANUAL[ \t]*/, "") }
        gsub(/[ \t]+$/, "")
        printf "%s\t%s\t%s\n", id, kind, $0
    }
' "$SPEC")

[ -n "$CRITERIA" ] || die "no acceptance criteria found in $SPEC (expected a '## Acceptance criteria' section with '- C1 ...' lines; ids are an uppercase prefix and a number, so B1 works too)"

# The frame and rail print here, before this run's own run/<timestamp>/
# directory is created below - stage-rail reads run/ history to compute
# verify's own position, and a run directory that exists but has not
# finished yet (just its header line written) would otherwise read as an
# empty, all-passed run and show the wrong state for the very run in progress.
announce_root_if_needed

reveal_opening_frame "delta verify $SEP $label"
printf '\n'
[ -x "$script_dir/stage-rail" ] && "$script_dir/stage-rail" verify "$CHANGE_DIR"
printf '\n'

# The reproduction ledger is tracked in git alongside signoff.md, unlike the
# per-run directories. It has to survive a fresh clone: it is what distinguishes
# "this bug was reproduced and is now fixed" from "this reproduction never
# reproduced anything".
LEDGER="$CHANGE_DIR/run/reproductions.md"

ledger_init() {
    [ -f "$LEDGER" ] && return 0
    mkdir -p "$CHANGE_DIR/run" || return 1
    {
        printf '# Reproduction ledger\n\n'
        printf 'Written by delta/bin/verify. One line per event:\n\n'
        printf '    C<n> reproduced: <utc> - exit <code>\n'
        printf '    C<n> fixed: <utc> - reproduced <utc>\n\n'
        printf 'A `fixed` line is the evidence that a fix worked: the check failed\n'
        printf 'before it and passes after. Do not edit this file by hand.\n\n'
    } > "$LEDGER"
}

ledger_first_reproduced() {  # echo the utc of the first reproduction of $1
    [ -f "$LEDGER" ] || return 1
    _l=$(grep -m1 "^$1 reproduced:" "$LEDGER" 2>/dev/null) || return 1
    [ -n "$_l" ] || return 1
    printf '%s' "$_l" | sed 's/^[^:]*:[ ]*//; s/[ ]-[ ].*$//'
}

ledger_fixed() { [ -f "$LEDGER" ] && grep -q "^$1 fixed:" "$LEDGER" 2>/dev/null; }

expect_of() {  # echo the EXPECT value of check $1, defaulting to pass
    _e=$(grep -m1 '^#[ 	]*EXPECT:' "$1" 2>/dev/null \
         | sed 's/^#[ 	]*EXPECT:[ 	]*//' | awk '{print $1}')
    case "$_e" in
        fail-until-fixed) printf 'fail-until-fixed' ;;
        ''|pass)          printf 'pass' ;;
        *)                printf 'pass' ;;
    esac
}

# Rewriting the check is what makes the flip permanent. The EXPECT line is
# replaced rather than deleted, so the file still says what happened to it.
flip_check() {  # $1 check path, $2 first-reproduced utc, $3 now
    _tmp="$1.delta-flip.$$"
    awk -v r="$2" -v f="$3" '
        !flipped && /^#[ \t]*EXPECT:[ \t]*fail-until-fixed/ {
            printf "# EXPECT: pass  (was fail-until-fixed; reproduced %s, fixed %s)\n", r, f
            flipped = 1
            next
        }
        { print }
    ' "$1" > "$_tmp" || { rm -f "$_tmp"; return 1; }
    chmod +x "$_tmp" && mv "$_tmp" "$1"
}

find_check() {  # echo path of the check bound to criterion $1, if any
    [ -d "$CHECKS_DIR" ] || return 1
    for _f in "$CHECKS_DIR"/*; do
        [ -f "$_f" ] || continue
        _b=${_f##*/}
        case "$_b" in
            "$1"|"$1"[-_.]*) printf '%s' "$_f"; return 0 ;;
        esac
    done
    return 1
}

has_signoff() {
    [ -f "$SIGNOFF" ] || return 1
    grep -qE "^[[:space:]]*$1([[:space:]]|:)" "$SIGNOFF"
}

# ------------------------------------------------------------------ setup ----

started_utc=$(date -u +%Y-%m-%dT%H-%M-%S)
RUN_DIR="$CHANGE_DIR/run/$started_utc"
mkdir -p "$RUN_DIR" || die "cannot create $RUN_DIR"

RESULTS="$RUN_DIR/results.tsv"
{
    printf 'criterion\tstatus\texit_code\tstarted_utc\tduration_ms\tlog\tdescription\n'
} > "$RESULTS"

git_rev=$(cd "$ROOT" && git rev-parse HEAD 2>/dev/null) || git_rev=unknown
{
    printf 'change: %s\n'          "$label"
    printf 'started_utc: %s\n'     "$started_utc"
    printf 'git_rev: %s\n'         "$git_rev"
    printf 'root: %s\n'            "$ROOT"
} > "$RUN_DIR/meta.txt"

# Column geometry. Ids are short; widen for C10+ if present.
idw=2
for _line in $(printf '%s\n' "$CRITERIA" | cut -f1); do
    [ ${#_line} -gt "$idw" ] && idw=${#_line}
done
durw=10  # widest right-hand word: "signed off"
descw=$((cols - 2 - GLYPH_W - 1 - idw - 2 - durw - 1))
[ "$descw" -lt 12 ] && descw=12

emit() {  # $1 glyph, $2 colour, $3 id, $4 desc, $5 right-hand column
    printf '%s  %s %s %s %s%s\n' "$CLEAR" \
        "$2$(pad "$1" "$GLYPH_W")$C_OFF" \
        "$(pad "$3" "$idw")" \
        "$(pad "$(trunc "$4" "$descw")" "$descw")" \
        "$C_DIM" "$(pad_left "$5" "$durw")$C_OFF"
}

# ------------------------------------------------------------------- run ----

total=0; passed=0; failed=0; manual=0; manual_open=0; unchecked=0
FAILLOG="$RUN_DIR/.failures"
WARNLOG="$RUN_DIR/.warnings"
: > "$FAILLOG"
: > "$WARNLOG"

run_started=$(now_ms)

printf '%s\n' "$CRITERIA" | while IFS='	' read -r id kind desc; do
    [ -n "$id" ] || continue
    total=$((total + 1))

    if [ "$kind" = MANUAL ]; then
        if has_signoff "$id"; then
            emit "$G_MAN" "$C_DIM" "$id" "$desc" "signed off"
            printf '%s\tmanual-signed\t\t%s\t\t\t%s\n' "$id" "$started_utc" "$desc" >> "$RESULTS"
        else
            emit "$G_MAN" "$C_DIM" "$id" "$desc" "manual"
            printf '%s\tmanual-open\t\t%s\t\t\t%s\n' "$id" "$started_utc" "$desc" >> "$RESULTS"
            printf 'manual\t%s\t%s\n' "$id" "$desc" >> "$FAILLOG"
        fi
        continue
    fi

    chk=$(find_check "$id") || chk=''
    if [ -z "$chk" ]; then
        emit "$G_FAIL" "$C_FAIL" "$id" "$desc" "no check"
        printf '%s\tno-check\t\t%s\t\t\t%s\n' "$id" "$started_utc" "$desc" >> "$RESULTS"
        printf 'nocheck\t%s\t%s\n' "$id" "$desc" >> "$FAILLOG"
        continue
    fi

    log="$RUN_DIR/$id.log"
    rel_log="run/$started_utc/$id.log"

    # A check whose CRITERION header disagrees with its filename is a
    # copy-paste error worth surfacing; it does not change the exit code.
    hdr=$(grep -m1 '^#[ \t]*CRITERION:' "$chk" 2>/dev/null | sed 's/^#[ \t]*CRITERION:[ \t]*//')
    case "$hdr" in
        '') : ;;
        "$id"|"$id "*|"$id$TAB"*) : ;;
        *) printf '%s: CRITERION header does not start with %s\n' "${chk##*/}" "$id" >> "$WARNLOG" ;;
    esac

    expect=$(expect_of "$chk")

    # Not executable is a configuration problem, not a criterion that failed
    # to hold - the check never ran, so it has nothing to say about the
    # criterion. Keeping it out of the failed count is what stops someone
    # from going to debug application code that is fine.
    if [ ! -x "$chk" ]; then
        printf 'check file is not executable: %s\nrun: chmod +x %s\n' "$chk" "$chk" > "$log"
        emit "$G_ERR" "$C_FAIL" "$id" "$desc" "error"
        printf '%s\terror\t126\t%s\t0\t%s\t%s\n' "$id" "$started_utc" "$rel_log" "$desc" >> "$RESULTS"
        printf 'error\t%s\tcheck file is not executable - chmod +x it\t%s\n' "$id" "$rel_log" >> "$FAILLOG"
        continue
    fi

    t0=$(now_ms)
    if [ "$spinner_ok" -eq 1 ]; then
        printf '%s' "$CURSOR_HIDE"
        ( cd "$ROOT" && DELTA_CHANGE_DIR="$CHANGE_DIR" DELTA_CHECK_DIR="$CHECKS_DIR" \
            DELTA_RUN_DIR="$RUN_DIR" DELTA_CRITERION="$id" exec "$chk" ) >"$log" 2>&1 &
        cpid=$!
        i=0
        while kill -0 "$cpid" 2>/dev/null; do
            # Recomputed every tick, not cached from script start: a resize
            # mid-run must not corrupt this line. Cheap enough at 0.1s.
            _cols=0
            case "${COLUMNS-}" in ''|*[!0-9]*) : ;; *) _cols=$COLUMNS ;; esac
            if [ "$_cols" -eq 0 ] && command -v tput >/dev/null 2>&1; then
                _cols=$(tput cols 2>/dev/null </dev/tty) || _cols=0
            fi
            case "$_cols" in ''|*[!0-9]*) _cols=0 ;; esac
            [ "$_cols" -lt 40 ] && _cols=80
            [ "$_cols" -gt 100 ] && _cols=100
            cols=$_cols
            _live_descw=$((cols - 2 - GLYPH_W - 1 - 8 - idw - 2 - 6))
            [ "$_live_descw" -lt 8 ] && _live_descw=8

            _elapsed_ms=$(( $(now_ms) - t0 ))
            _es=$((_elapsed_ms / 1000))
            printf '\r  %s running  %s %s %s' "$(spin_frame "$i")" \
                "$(pad "$id" "$idw")" "$(trunc "$desc" "$_live_descw")" \
                "$(pad_left "$((_es / 60)):$(printf '%02d' "$((_es % 60))")" 6)"
            i=$((i + 1))
            sleep 0.1
        done
        wait "$cpid"; rc=$?
        cpid=''
    else
        [ "$is_tty" -eq 0 ] || printf '  %s %s %s\n' "$(pad "$G_PEND" "$GLYPH_W")" \
            "$(pad "$id" "$idw")" "$(trunc "$desc" "$descw")"
        ( cd "$ROOT" && DELTA_CHANGE_DIR="$CHANGE_DIR" DELTA_CHECK_DIR="$CHECKS_DIR" \
            DELTA_RUN_DIR="$RUN_DIR" DELTA_CRITERION="$id" exec "$chk" ) >"$log" 2>&1
        rc=$?
    fi
    t1=$(now_ms)
    dur=$((t1 - t0))
    [ "$dur" -lt 0 ] && dur=0

    detail=$(grep -v '^[ \t]*$' "$log" 2>/dev/null | tail -n 1)

    # 126 (permission denied) and 127 (command not found) are the shell's own
    # exec-failure codes - conventionally a missing or non-executable
    # interpreter named in the shebang, not something the check's own logic
    # produced. The check could not run, so it is an error, not a criterion
    # that failed to hold: the same distinction as the not-executable guard
    # above, just discovered one step later, after the exec was attempted.
    if [ "$rc" -eq 126 ] || [ "$rc" -eq 127 ]; then
        emit "$G_ERR" "$C_FAIL" "$id" "$desc" "error"
        printf '%s\terror\t%s\t%s\t%s\t%s\t%s\n' "$id" "$rc" "$started_utc" "$dur" "$rel_log" "$desc" >> "$RESULTS"
        [ -n "$detail" ] || detail="exited $rc: interpreter missing or not executable"
        printf 'error\t%s\t%s\t%s\n' "$id" "$detail" "$rel_log" >> "$FAILLOG"
        continue
    fi

    if [ "$expect" = fail-until-fixed ]; then
        first=$(ledger_first_reproduced "$id") || first=''
        if [ "$rc" -ne 0 ]; then
            # The bug is confirmed. This is the point of the check, not a fault.
            if [ -z "$first" ]; then
                ledger_init && printf '%s reproduced: %s - exit %s\n' \
                    "$id" "$started_utc" "$rc" >> "$LEDGER"
                first=$started_utc
            fi
            emit "$G_REPRO" "" "$id" "$desc" "reproduced"
            printf '%s\treproduced\t%s\t%s\t%s\t%s\t%s\n' \
                "$id" "$rc" "$started_utc" "$dur" "$rel_log" "$desc" >> "$RESULTS"
            [ -n "$detail" ] || detail="exited $rc with no output"
            printf 'repro\t%s\t%s\t%s\n' "$id" "$detail" "$rel_log" >> "$FAILLOG"
        elif [ -n "$first" ]; then
            # It failed before and passes now. That is the fix, proven.
            flip_check "$chk" "$first" "$started_utc" \
                && printf '%s fixed: %s - reproduced %s\n' \
                    "$id" "$started_utc" "$first" >> "$LEDGER"
            emit "$G_PASS" "$C_PASS" "$id" "$desc" "fixed"
            printf '%s\tfixed\t0\t%s\t%s\t%s\t%s\n' \
                "$id" "$started_utc" "$dur" "$rel_log" "$desc" >> "$RESULTS"
            printf 'fixed\t%s\tfixed %s (reproduced %s) - now a regression guard\t%s\n' \
                "$id" "$started_utc" "$first" "$rel_log" >> "$FAILLOG"
        else
            # It was never seen failing, so it is not reproducing the bug.
            emit "$G_SUSP" "$C_FAIL" "$id" "$desc" "suspicious"
            printf '%s\tsuspicious\t0\t%s\t%s\t%s\t%s\n' \
                "$id" "$started_utc" "$dur" "$rel_log" "$desc" >> "$RESULTS"
            printf 'susp\t%s\tpassed on a fresh spec - the reproduction does not reproduce\t%s\n' \
                "$id" "$rel_log" >> "$FAILLOG"
        fi
    elif [ "$rc" -eq 0 ]; then
        emit "$G_PASS" "$C_PASS" "$id" "$desc" "$(fmt_dur "$dur")"
        printf '%s\tpassed\t0\t%s\t%s\t%s\t%s\n' "$id" "$started_utc" "$dur" "$rel_log" "$desc" >> "$RESULTS"
    else
        emit "$G_FAIL" "$C_FAIL" "$id" "$desc" "$(fmt_dur "$dur")"
        printf '%s\tfailed\t%s\t%s\t%s\t%s\t%s\n' "$id" "$rc" "$started_utc" "$dur" "$rel_log" "$desc" >> "$RESULTS"
        [ -n "$detail" ] || detail="exited $rc with no output"
        printf 'fail\t%s\t%s\t%s\n' "$id" "$detail" "$rel_log" >> "$FAILLOG"
    fi
done

run_ms=$(( $(now_ms) - run_started ))
[ "$run_ms" -lt 0 ] && run_ms=0

# The while loop above runs in a subshell (pipeline), so recount from results.
total=$(awk 'NR > 1' "$RESULTS" | wc -l | tr -d ' ')
passed=$(awk -F'\t' 'NR > 1 && $2 == "passed"' "$RESULTS" | wc -l | tr -d ' ')
failed=$(awk -F'\t' 'NR > 1 && $2 == "failed"' "$RESULTS" | wc -l | tr -d ' ')
unchecked=$(awk -F'\t' 'NR > 1 && $2 == "no-check"' "$RESULTS" | wc -l | tr -d ' ')
manual=$(awk -F'\t' 'NR > 1 && ($2 == "manual-open" || $2 == "manual-signed")' "$RESULTS" | wc -l | tr -d ' ')
manual_open=$(awk -F'\t' 'NR > 1 && $2 == "manual-open"' "$RESULTS" | wc -l | tr -d ' ')
reproduced=$(awk -F'\t' 'NR > 1 && $2 == "reproduced"' "$RESULTS" | wc -l | tr -d ' ')
suspicious=$(awk -F'\t' 'NR > 1 && $2 == "suspicious"' "$RESULTS" | wc -l | tr -d ' ')
fixed=$(awk -F'\t' 'NR > 1 && $2 == "fixed"' "$RESULTS" | wc -l | tr -d ' ')
errored=$(awk -F'\t' 'NR > 1 && $2 == "error"' "$RESULTS" | wc -l | tr -d ' ')
# A flipped reproduction is a pass: it failed before the fix and passes after.
passed=$((passed + fixed))

# ------------------------------------------------------------- reporting ----

if [ -s "$WARNLOG" ]; then
    printf '\n'
    while IFS= read -r w; do
        printf '  %s%s  %s%s\n' "$C_DIM" "$(pad '!' "$GLYPH_W")" "$w" "$C_OFF"
    done < "$WARNLOG"
fi

# Failure detail goes above the summary so the summary is what stays on screen.
# Detail lines truncate rather than wrap, same as the result lines: the full
# text is always in the log whose path is printed directly beneath.
detw=$((cols - 2 - GLYPH_W - 1 - idw - 2))
[ "$detw" -lt 20 ] && detw=20
hintw=$((cols - 2 - GLYPH_W - idw - 3))
[ "$hintw" -lt 20 ] && hintw=20

hint() {  # indented, dimmed, truncated second line under a detail entry
    printf '  %s%s%s\n' "$C_DIM" \
        "$(pad '' $((GLYPH_W + idw + 3)))$(trunc "$1" "$hintw")" "$C_OFF"
}
if [ -s "$FAILLOG" ]; then
    printf '\n'
    while IFS='	' read -r what id detail rel; do
        case "$what" in
            fail)
                printf '  %s%s%s %s  %s\n' "$C_FAIL" "$(pad "$G_FAIL" "$GLYPH_W")" "$C_OFF" \
                    "$(pad "$id" "$idw")" "$(trunc "$detail" "$detw")"
                [ -n "${rel:-}" ] && hint "$rel"
                ;;
            nocheck)
                printf '  %s%s%s %s  %s\n' "$C_FAIL" "$(pad "$G_FAIL" "$GLYPH_W")" "$C_OFF" \
                    "$(pad "$id" "$idw")" "no check bound to this criterion"
                hint "add an executable $CHECKS_DIR/$id-*.sh"
                ;;
            manual)
                printf '  %s%s %s  %s%s\n' "$C_DIM" "$(pad "$G_MAN" "$GLYPH_W")" \
                    "$(pad "$id" "$idw")" "$(trunc "awaiting sign-off: $detail" "$detw")" "$C_OFF"
                hint "record it in run/signoff.md"
                ;;
            repro)
                printf '  %s %s  %s\n' "$(pad "$G_REPRO" "$GLYPH_W")" \
                    "$(pad "$id" "$idw")" "$(trunc "reproduced: $detail" "$detw")"
                [ -n "${rel:-}" ] && hint "$rel"
                ;;
            fixed)
                printf '  %s%s%s %s  %s\n' "$C_PASS" "$(pad "$G_PASS" "$GLYPH_W")" "$C_OFF" \
                    "$(pad "$id" "$idw")" "$(trunc "$detail" "$detw")"
                hint "recorded in run/reproductions.md"
                ;;
            susp)
                printf '  %s%s%s %s  %s\n' "$C_FAIL" "$(pad "$G_SUSP" "$GLYPH_W")" "$C_OFF" \
                    "$(pad "$id" "$idw")" "$(trunc "$detail" "$detw")"
                hint "the criterion is wrong, or the bug was already fixed"
                ;;
            error)
                printf '  %s%s%s %s  %s\n' "$C_FAIL" "$(pad "$G_ERR" "$GLYPH_W")" "$C_OFF" \
                    "$(pad "$id" "$idw")" "$(trunc "$detail" "$detw")"
                [ -n "${rel:-}" ] && hint "$rel"
                ;;
        esac
    done < "$FAILLOG"
fi

if [ "$total" -eq 1 ]; then _noun=criterion; else _noun=criteria; fi

# The completion moment: clean vs failing is the one distinction the
# developer is actually waiting for, so it gets one beat of visual
# difference - never the whole line in red, only the count(s) that are
# actually wrong, and never colour applied to a plain terminal/no-colour run
# (C_PASS/C_FAIL/C_ACCENT are already '' there, so this degrades for free).
run_clean=1
[ "$errored"     -gt 0 ] && run_clean=0
[ "$failed"      -gt 0 ] && run_clean=0
[ "$suspicious"  -gt 0 ] && run_clean=0
[ "$unchecked"   -gt 0 ] && run_clean=0
[ "$manual_open" -gt 0 ] && run_clean=0
[ "$archive_gate" -eq 1 ] && [ "$reproduced" -gt 0 ] && run_clean=0

if [ "$run_clean" -eq 1 ]; then
    summary="$total $_noun $SEP ${C_PASS}${passed} passed${C_OFF}"
else
    summary="$total $_noun $SEP $passed passed"
fi
[ "$failed"     -gt 0 ] && summary="$summary $SEP ${C_FAIL}${failed} failed${C_OFF}"
[ "$reproduced" -gt 0 ] && summary="$summary $SEP $reproduced reproduced"
[ "$suspicious" -gt 0 ] && summary="$summary $SEP ${C_FAIL}${suspicious} suspicious${C_OFF}"
[ "$errored"    -gt 0 ] && summary="$summary $SEP ${C_FAIL}${errored} error(s)${C_OFF}"
[ "$unchecked"  -gt 0 ] && summary="$summary $SEP ${C_FAIL}${unchecked} unchecked${C_OFF}"
[ "$manual"     -gt 0 ] && summary="$summary $SEP $manual manual"
summary="$summary $SEP $(fmt_dur "$run_ms")"

# The colour codes above are for the terminal only - strip them before this
# same string is written to summary.txt or measured for width, so the log
# stays plain text and column math is never thrown off by invisible bytes.
summary_plain=$(printf '%s' "$summary" | sed 's/\x1b\[[0-9;]*m//g')

# The archive gate names what is outstanding, because "cannot archive" without
# the list is a dead end for whoever reads it.
if [ "$archive_gate" -eq 1 ] && [ "$reproduced" -gt 0 ]; then
    printf '\n'
    printf '  %scannot archive: %s reproduction(s) still outstanding%s\n' \
        "$C_FAIL" "$reproduced" "$C_OFF"
    awk -F'\t' 'NR > 1 && $2 == "reproduced" { printf "        %s  %s\n", $1, $7 }' "$RESULTS"
    printf '  %sfolding this into truth would record a bug as fixed that is not%s\n' \
        "$C_DIM" "$C_OFF"
fi

printf '\n'
if [ "$run_clean" -eq 1 ]; then
    rule_line "$summary" "$C_ACCENT" "$summary_plain"
else
    rule_line "$summary" '' "$summary_plain"
fi

{
    printf '%s\n' "$summary_plain"
    printf 'change: %s\n' "$label"
    printf 'run: %s\n' "$started_utc"
} > "$RUN_DIR/summary.txt"

rm -f "$FAILLOG" "$WARNLOG"

# --------------------------------------------------------------- exit code ----

if   [ "$errored"     -gt 0 ]; then exit 7
elif [ "$failed"      -gt 0 ]; then exit 1
elif [ "$suspicious"  -gt 0 ]; then exit 6
elif [ "$unchecked"   -gt 0 ]; then exit 2
elif [ "$manual_open" -gt 0 ]; then exit 3
elif [ "$archive_gate" -eq 1 ] && [ "$reproduced" -gt 0 ]; then exit 5
else                                exit 0
fi
